# Hashi Lens runs in Ollama mode
LLM_PROVIDER=ollama

# Ollama provider settings (used when LLM_PROVIDER=ollama)
# Optional placeholder for OpenAI-compatible client auth
OLLAMA_API_KEY=ollama
OLLAMA_BASE_URL=http://ollama.localhost:11434/v1
OLLAMA_MODEL=gemma4:latest

# MCP servers (stdio command paths)
VAULT_MCP_COMMAND=/path/to/.hal/bin/vault-mcp-server
VAULT_AUDIT_MCP_COMMAND=/path/to/.hal/bin/vault-audit-mcp
HAL_MCP_COMMAND=~/.hal/bin/hal-mcp
TERRAFORM_MCP_COMMAND=/path/to/.hal/bin/terraform-mcp
CONSUL_MCP_COMMAND=/path/to/.hal/bin/consul-mcp
NOMAD_MCP_COMMAND=/path/to/.hal/bin/nomad-mcp
BOUNDARY_MCP_COMMAND=/path/to/.hal/bin/boundary-mcp
TFE_MCP_COMMAND=/path/to/.hal/bin/tfe-mcp

# Loki endpoint consumed by vault-audit-mcp
LOKI_URL=http://loki.localhost:3100

# OIDC callback URL used by server auth manager
VAULT_OIDC_REDIRECT_URI=http://localhost:8250/oidc/callback

# Optional Vault bootstrap for local sandbox mode (no UI connect needed)
# VAULT_ADDR=http://vault.localhost:8200
# VAULT_TOKEN=<your-local-token>
# VAULT_SKIP_VERIFY=false

# Optional: enable verbose MCP stdio client logging
HASHILENS_MCP_DEBUG_LOGS=false

# Backend API server port
API_PORT=9001

# Frontend dev server port
VITE_PORT=9000

# Public frontend hostname
VITE_HOSTNAME=hal.localhost
